# ===== 任务管理系统后端配置模板 =====
# 使用方式：复制为 Backend/.env 后按需修改；桌面安装版由运行时管理器自动注入连接信息。

# 应用信息
appName=任务管理系统
appVersion=1.0.0
debug=false

# 服务监听：0.0.0.0 表示允许局域网访问
host=0.0.0.0
port=8765

# 数据库（MySQL / MariaDB）
databaseUrl=mysql+pymysql://taskadmin:taskadmin123@127.0.0.1:3307/task_management?charset=utf8mb4

# 缓存（Redis）
redisUrl=redis://127.0.0.1:6380/0

# 身份认证：生产环境务必替换为随机长字符串
jwtSecret=please-replace-with-a-long-random-secret
jwtAlgorithm=HS256
jwtExpireDays=7

# 内置超级用户（首次启动自动创建）
superAdminUsername=superAdmin
superAdminPassword=SuperAdmin@123
superAdminNickname=超级管理员

# 跨域白名单（Tauri 打包后前端来源）
corsOrigins=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost,https://tauri.localhost

# 前端构建产物目录（留空则自动使用 ../Frontend/dist）
frontendDistPath=

# ===== v1.1 AI 自动分配（移植自 Java AI 模块） =====
# 调度模式：LOCAL_ONLY / LLM_ONLY / LOCAL_FIRST（默认） / LLM_FIRST
assignmentDispatchMode=LOCAL_FIRST
# 本地推荐最低分阈值与每个活跃待办的负载惩罚分
assignmentMatchThreshold=50
assignmentWorkloadPenalty=5
# LLM（OpenAI 兼容协议）配置：三项齐全才启用；api-key 请勿提交到仓库
llmBaseUrl=
llmChatPath=/v1/chat/completions
llmApiKey=
llmModel=
llmTimeoutSeconds=20
llmMaxCandidates=20
